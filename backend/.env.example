# DateNight Backend — environment template (no secrets here)

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://datenight:datenight@localhost:5432/datenight?schema=public

# Redis — localhost/127.0.0.1 automatically falls back to in-memory cache
REDIS_URL=redis://localhost:6379

# Auth
# Generate with: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
# Comma-separated list of allowed origins. The server splits by comma into an array.
# Development: CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8081
# Production: list only real domains — NEVER use a wildcard (*) in production.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Third-party APIs (optional in dev — suggestion engine falls back to curated seed data)
GOOGLE_MAPS_API_KEY=
YELP_API_KEY=
TMDB_API_KEY=
GEMINI_API_KEY=
