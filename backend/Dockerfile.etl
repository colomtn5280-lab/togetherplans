# DateMeUp — Venue ETL Cloud Run Job
# Runs the Overture Maps + OSM/NPS/IMLS ETL scripts.
# Separate from the API image so it can carry heavier tools (DuckDB, AWS CLI, psql)
# without bloating the API container.
#
# Triggered via: gcloud run jobs execute venue-etl [--args ...]

FROM python:3.12-slim

WORKDIR /app

# System deps: psql client for COPY, AWS CLI for S3 access, curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# AWS CLI v2 (for Overture Maps S3 public bucket — no credentials needed)
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscliv2.zip /tmp/aws

# Python deps: DuckDB for Parquet + S3 reads, psycopg2 for DB, requests for APIs
RUN pip install --no-cache-dir \
    duckdb==1.1.3 \
    psycopg2-binary==2.9.10 \
    requests==2.32.3

# Copy ETL scripts
COPY scripts/ ./scripts/

# Default: run Phase 2 Overture ETL for all states
# Override CMD args via --args in gcloud run jobs execute
CMD ["python3", "scripts/load-fsq-venues.py", "--phase", "2"]
