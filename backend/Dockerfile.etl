# DateMeUp — Venue ETL Cloud Run Job
# Runs the Overture Maps + OSM/NPS/IMLS ETL scripts.
# Separate from the API image so it can carry heavier tools (DuckDB, psql)
# without bloating the API container.
#
# Triggered via: gcloud run jobs execute venue-etl [--args ...]
# Default (no --args): runs Phase 2 Overture ETL
# Override script:     --args="scripts/load-osm-trails.py,--source,all"

FROM python:3.12-slim

WORKDIR /app

# System deps: psql client for COPY
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Python deps: DuckDB for Parquet + S3 reads (httpfs extension built-in),
#              psycopg2 for DB, requests for APIs (NPS, Overpass)
RUN pip install --no-cache-dir "duckdb==1.1.3" "psycopg2-binary==2.9.10" "requests==2.32.3"

# Pre-install DuckDB extensions at build time (avoids runtime network calls in Cloud Run)
RUN python3 -c "import duckdb; c=duckdb.connect(); c.execute('INSTALL httpfs'); c.execute('INSTALL spatial'); c.close(); print('DuckDB extensions ok')"

# Copy ETL scripts
COPY scripts/ ./scripts/

# ENTRYPOINT + CMD: --args in gcloud run jobs execute replaces CMD only.
# Default runs Phase 2 Overture ETL; override with --args to run other scripts.
ENTRYPOINT ["python3"]
CMD ["scripts/load-fsq-venues.py", "--phase", "2"]
