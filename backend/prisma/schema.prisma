// DateNight — Prisma schema
// Users, groups, invitations, date proposals, activity options, votes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  displayName  String
  // OAuth provider fields
  provider     String?   // 'google' | 'apple' | 'facebook' | 'linkedin' | 'microsoft'
  providerId   String?   // provider's user ID
  avatarUrl    String?
  pushToken    String?   // Expo push notification token
  // Optional home location for recommendations
  latitude     Float?
  longitude    Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // GDPR: soft-delete marker; hard delete via scheduled job within 30 days
  deletedAt    DateTime?

  memberships     GroupMember[]
  sentInvitations Invitation[]  @relation("Inviter")
  proposals       Proposal[]
  votes           Vote[]
  refreshTokens   RefreshToken[]
  blocking        BlockedUser[] @relation("BlockerRelation")
  blockedBy       BlockedUser[] @relation("BlockedRelation")
  reports         Report[]      @relation("ReporterRelation")
  afterDarkIdeas  AfterDarkItem[]

  @@unique([provider, providerId])
}

model BlockedUser {
  id          String   @id @default(cuid())
  blockerId   String
  blockedId   String
  createdAt   DateTime @default(now())
  blocker     User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
}

model Report {
  id                  String   @id @default(cuid())
  reporterId          String
  reportedUserId      String?
  reportedContentType String?
  reportedContentId   String?
  reason              String
  details             String?
  status              String   @default("pending")
  createdAt           DateTime @default(now())
  reporter            User     @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  groupType   String?  // 'COUPLE' | 'FRIENDS' | 'FAMILY'
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     GroupMember[]
  invitations Invitation[]
  proposals   Proposal[]
  afterDarkItems AfterDarkItem[]
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

enum Role {
  OWNER
  MEMBER
}

// Invitation methods: LINK, EMAIL, SMS, QR, USERNAME (5 methods per spec)
enum InviteMethod {
  LINK
  EMAIL
  SMS
  QR
  USERNAME
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Invitation {
  id        String       @id @default(uuid())
  groupId   String
  inviterId String
  method    InviteMethod
  // token used in invite links / QR codes
  token     String       @unique @default(uuid())
  // target contact for EMAIL/SMS/USERNAME methods
  target    String?
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User  @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
}

enum ProposalStatus {
  OPEN
  COUNTERED
  DECIDED
  CANCELLED
}

model Proposal {
  id         String         @id @default(uuid())
  groupId    String
  creatorId  String
  title      String
  // proposed date/time of the outing
  dateTime   DateTime
  status     ProposalStatus @default(OPEN)
  // public share token for guest voting links — generated lazily on first share
  shareToken String?        @unique
  // if this proposal is a counter-proposal, link to the original
  parentId   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  remindedAt DateTime?

  group    Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator  User       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  parent     Proposal?   @relation("CounterProposals", fields: [parentId], references: [id])
  counters   Proposal[]  @relation("CounterProposals")
  options    Option[]
  guestVotes GuestVote[]

  @@index([groupId])
}

model Option {
  id          String   @id @default(uuid())
  proposalId  String
  name        String
  category    String // e.g. restaurant, movie, activity, outdoors
  description String?
  address     String?
  latitude    Float?
  longitude   Float?
  // external reference (Yelp/TMDB/Google Place id) when sourced from an API
  externalRef String?
  // Rich event data fields
  imageUrl    String?
  sourceUrl   String?
  eventDate   DateTime?
  rating      Float?
  priceLevel  Int?
  sourceName  String?
  createdAt   DateTime @default(now())

  proposal   Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  votes      Vote[]
  guestVotes GuestVote[]
}

// Guest votes: anonymous voters via public share link — advisory only,
// never counted toward member consensus / match logic.
model GuestVote {
  id         String   @id @default(uuid())
  proposalId String
  optionId   String
  // random client-generated token (UUID persisted in the guest's browser)
  guestId    String
  guestName  String?
  createdAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  option   Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([proposalId, guestId])
  @@index([optionId])
}

model Vote {
  id        String   @id @default(uuid())
  optionId  String
  userId    String
  // simple approval voting: a vote row = approval
  createdAt DateTime @default(now())

  option Option @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([optionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Business {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  category     String
  description  String   @default("")
  address      String   @default("")
  city         String   @default("")
  state        String   @default("")
  zipCode      String   @default("")
  lat          Float?
  lng          Float?
  website      String?
  phone        String?
  logoUrl      String?
  photos       String[]
  priceRange   String   @default("$$")
  tags         String[]
  tier         String   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  active       Boolean  @default(true)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  listings     FeaturedListing[]
  impressions  BusinessImpression[]
}

model FeaturedListing {
  id           String   @id @default(cuid())
  businessId   String
  title        String
  description  String
  imageUrl     String?
  ctaText      String   @default("Learn More")
  ctaUrl       String?
  startDate    DateTime?
  endDate      DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessImpression {
  id           String   @id @default(cuid())
  businessId   String
  eventType    String
  userId       String?
  proposalId   String?
  metadata     Json?
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ── After Dark: Intimate/Playful Activities for Couples ──────────────────────

model AfterDarkItem {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(140)
  description   String   @db.Text
  tier          String   // ROMANTIC | SPICY
  icon          String?  // Emoji or icon name
  color         String   // Hex color (#B2485E, #8E3448, etc.)
  createdBy     String?  // null for seed items, userId for couple-created ideas
  groupId       String?  // null for public seed catalog, groupId for couple ideas
  reportedCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  group         Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator       User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([createdBy])
  @@index([tier])
  @@index([createdAt])
}
