{
  "expo": {
    "name": "DateNight",
    "slug": "togetherplans",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "togetherplans",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7c3aed"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.togetherplans.datenight",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DateNight uses your location to suggest nearby activities.",
        "NSCameraUsageDescription": "DateNight uses your camera for QR code scanning.",
        "NSPhotoLibraryUsageDescription": "DateNight may access your photos for profile pictures.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.togetherplans.datenight",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#7c3aed"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF4081"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "apiBaseUrl": "https://api.togetherplans.app",
      "privacyPolicyUrl": "https://api.togetherplans.app/privacy",
      "termsUrl": "https://api.togetherplans.app/terms",
      "eas": {
        "projectId": "01082da3-36a9-4e80-94f3-a028aeab083f"
      }
    },
    "owner": "colomtn5280s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/01082da3-36a9-4e80-94f3-a028aeab083f"
    }
  }
}