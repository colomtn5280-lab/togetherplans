{
  "expo": {
    "name": "TogetherPlans",
    "slug": "togetherplans",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "togetherplans",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E8C8C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.togetherplans.datenight",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TogetherPlans uses your location to suggest nearby activities.",
        "NSCameraUsageDescription": "TogetherPlans uses your camera for QR code scanning.",
        "NSPhotoLibraryUsageDescription": "TogetherPlans may access your photos for profile pictures.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "togetherplans.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0E8C8C"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "togetherplans.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0E8C8C"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "apiBaseUrl": "https://api.togetherplans.app",
      "privacyPolicyUrl": "https://api.togetherplans.app/privacy",
      "termsUrl": "https://api.togetherplans.app/terms",
      "eas": {
        "projectId": "01082da3-36a9-4e80-94f3-a028aeab083f"
      }
    },
    "owner": "colomtn5280s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/01082da3-36a9-4e80-94f3-a028aeab083f"
    }
  }
}
