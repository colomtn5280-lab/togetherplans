{
  "expo": {
    "name": "DateMeUp",
    "slug": "togetherplans",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "datemeup",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E8C8C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.togetherplans.datenight",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DateMeUp uses your location to suggest nearby activities.",
        "NSCameraUsageDescription": "DateMeUp uses your camera for QR code scanning.",
        "NSPhotoLibraryUsageDescription": "DateMeUp may access your photos for profile pictures.",
        "NSCalendarsUsageDescription": "TogetherPlans needs calendar access to add your date night to your calendar.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "8"
    },
    "android": {
      "package": "datemeup.app",
      "versionCode": 8,
      "targetSdkVersion": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0E8C8C"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "datemeup.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0E8C8C"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "DateMeUp shows ads to keep the app free. Allowing tracking lets us show you ads relevant to your interests. You can change this anytime in Settings > Privacy."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "DateMeUp shows ads to keep the app free. Allowing tracking helps us show you more relevant ads.",
          "skAdNetworkItems": [
            { "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork" }
          ]
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.datemeup.app",
      "privacyPolicyUrl": "https://api.datemeup.app/privacy",
      "termsUrl": "https://api.datemeup.app/terms",
      "eas": {
        "projectId": "01082da3-36a9-4e80-94f3-a028aeab083f"
      }
    },
    "owner": "colomtn5280s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/01082da3-36a9-4e80-94f3-a028aeab083f"
    }
  }
}
